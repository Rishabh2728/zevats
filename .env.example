# SMTP Mailbox Configuration for Zevats Contact Form Delivery
# Add these environment variables in your local environment (.env.local) and in Vercel Project Settings
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=465
SMTP_USER=hello@zevats.com
SMTP_PASSWORD=your-mailbox-password-or-app-password
CONTACT_TO=hello@zevats.com

# Optional overrides (auto-detected if omitted):
# SMTP_SECURE=true # true for SSL (port 465), false for STARTTLS (port 587)
# SMTP_FROM="Zevats Enquiries <hello@zevats.com>"
